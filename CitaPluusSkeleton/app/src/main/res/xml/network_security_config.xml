<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuración para desarrollo/debug -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Confiar en certificados del sistema -->
            <certificates src="system" />
            <!-- Confiar en certificados de usuario (útil para emulador) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Configuración específica para CIMA -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">cima.aemps.es</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>

